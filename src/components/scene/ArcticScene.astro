---
import Sky from './Sky.astro';
import Aurora from './Aurora.astro';
import Stars from './Stars.astro';
import Sun from './Sun.astro';
import Icebergs from './Icebergs.astro';
import Waterline from './Waterline.astro';
import Caustics from './Caustics.astro';

interface Props { variant?: 'full' | 'shallow' }
const { variant = 'shallow' } = Astro.props;
---
<div class="scene" data-variant={variant} aria-hidden="true">
  <Sky />
  <Sun />
  <Aurora />
  <Stars />
  <Icebergs />
  <Waterline />
  <Caustics />
</div>

<style>
  .scene {
    --horizon: 9rem;
    --berg-h: 6rem;
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 190vh;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    contain: paint;
  }
  .scene[data-variant='full'] {
    --horizon: 100vh;
    --berg-h: 21rem;
  }
</style>

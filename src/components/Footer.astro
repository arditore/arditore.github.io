---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const t = useTranslations(getLangFromUrl(Astro.url));
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap inner">
    <p class="note">{t('footer.built')}</p>
    <p class="meta">
      <span>{year}</span>
      <span aria-hidden="true">·</span>
      <a href="https://github.com/arditore">@arditore</a>
    </p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    margin-block-start: var(--space-8);
    padding-block: var(--space-6);
    border-block-start: 1px solid var(--border-deep);
    color: var(--text-deep-dim);
  }
  .inner {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .note {
    font-size: var(--step--1);
    max-width: 52ch;
  }
  .meta {
    display: flex;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
  .meta a {
    color: var(--text-deep);
  }
</style>

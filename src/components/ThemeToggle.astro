---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const t = useTranslations(getLangFromUrl(Astro.url));
---
<button type="button" class="toggle" aria-label={t('theme.toggle')} data-theme-toggle>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
    <circle class="orb" cx="12" cy="12" r="5" fill="currentColor"></circle>
    <g class="rays" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <line x1="12" y1="1.5" x2="12" y2="4"></line>
      <line x1="12" y1="20" x2="12" y2="22.5"></line>
      <line x1="1.5" y1="12" x2="4" y2="12"></line>
      <line x1="20" y1="12" x2="22.5" y2="12"></line>
      <line x1="4.4" y1="4.4" x2="6.2" y2="6.2"></line>
      <line x1="17.8" y1="17.8" x2="19.6" y2="19.6"></line>
      <line x1="4.4" y1="19.6" x2="6.2" y2="17.8"></line>
      <line x1="17.8" y1="6.2" x2="19.6" y2="4.4"></line>
    </g>
  </svg>
</button>

<script is:inline>
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', function () {
    var r = document.documentElement;
    var dark = getComputedStyle(r).getPropertyValue('--sun-opacity').trim() === '0';
    var next = dark ? 'light' : 'dark';
    r.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch (e) {}
  });
</script>

<style>
  .toggle {
    display: grid;
    place-items: center;
    inline-size: 2.4rem;
    block-size: 2.4rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }
  .toggle:hover {
    border-color: var(--accent);
  }
  .rays {
    opacity: var(--sun-opacity);
  }
  .orb {
    transform-origin: center;
    scale: calc(0.7 + var(--sun-opacity) * 0.3);
  }
</style>

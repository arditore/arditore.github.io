---
interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
}
const { title, eyebrow, lead } = Astro.props;
---

<article class="prose-page">
  <header class="wrap head">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot name="meta" />
  </header>

  <div class="wrap body">
    <slot />
  </div>
</article>

<style>
  .prose-page {
    color: var(--text-deep);
    padding-block: var(--space-7) var(--space-8);
  }
  .head {
    padding-block-end: var(--space-6);
  }
  .head .eyebrow {
    color: var(--text-deep-dim);
  }
  h1 {
    font-size: var(--step-4);
    margin-block: var(--space-3) var(--space-4);
  }
  .lead {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--text-deep);
    max-width: 44ch;
  }

  .body {
    max-width: min(100% - 2rem, 44rem);
    margin-inline: auto;
  }
  .body :global(h2) {
    font-size: var(--step-2);
    margin-block: var(--space-7) var(--space-4);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--border-deep);
  }
  .body :global(h3) {
    font-size: var(--step-1);
    margin-block: var(--space-6) var(--space-3);
  }
  .body :global(p) {
    margin-block: var(--space-4);
    color: var(--text-deep-dim);
    max-width: none;
  }
  .body :global(strong) {
    color: var(--text-deep);
    font-weight: 600;
  }
  .body :global(a) {
    color: var(--text-deep);
    text-decoration-color: var(--accent);
  }
  .body :global(ul),
  .body :global(ol) {
    margin-block: var(--space-4);
    color: var(--text-deep-dim);
    display: grid;
    gap: var(--space-2);
  }
  .body :global(code) {
    background: rgb(234 246 252 / 0.09);
    padding: 0.12em 0.4em;
    border-radius: 5px;
    color: var(--text-deep);
  }
  .body :global(pre) {
    background: rgb(5 25 42 / 0.55);
    border: 1px solid var(--border-deep);
    border-radius: var(--radius);
    padding: var(--space-4);
    overflow-x: auto;
  }
  .body :global(blockquote) {
    margin-block: var(--space-5);
    padding-inline-start: var(--space-4);
    border-inline-start: 3px solid var(--accent);
    color: var(--text-deep);
  }
</style>

---
import Base from '../../../layouts/Base.astro';
import Article from '../../../layouts/Article.astro';
import { render } from 'astro:content';
import { postsFor, postSlug, wordCount } from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = await postsFor('fr');
  return posts.map((entry) => ({ params: { slug: postSlug(entry) }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const words = wordCount(entry.body ?? '');
---
<Base title={`${entry.data.title} — Arditore`} description={entry.data.description}>
  <Article
    title={entry.data.title}
    lead={entry.data.description}
    pubDate={entry.data.pubDate}
    tags={entry.data.tags}
    words={words}
    headings={headings}
  >
    <Content />
  </Article>
</Base>

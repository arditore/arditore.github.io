---
import Base from '../../../layouts/Base.astro';
import Prose from '../../../layouts/Prose.astro';
import { render } from 'astro:content';
import { postsFor, postSlug } from '../../../lib/blog';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

export async function getStaticPaths() {
  const posts = await postsFor('fr');
  return posts.map((entry) => ({ params: { slug: postSlug(entry) }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const t = useTranslations(getLangFromUrl(Astro.url));
const published = entry.data.pubDate.toISOString().slice(0, 10);
---
<Base title={`${entry.data.title} — Arditore`} description={entry.data.description}>
  <Prose title={entry.data.title} eyebrow={t('nav.blog')} lead={entry.data.description}>
    <p slot="meta" class="published">
      {t('blog.published')} <time datetime={entry.data.pubDate.toISOString()}>{published}</time>
    </p>
    <Content />
  </Prose>
</Base>

<style>
  .published {
    margin-block-start: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-deep-dim);
  }
</style>
